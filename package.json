{
	"name": "webext-msg",
	"version": "2.0.0",
	"description": "WebExtension module: Simple message handler",
	"license": "MIT",
	"repository": "fregante/webext-msg",
	"funding": "https://github.com/sponsors/fregante",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc",
		"demo:build": "parcel build --no-cache",
		"demo:watch": "parcel watch --no-cache --no-hmr",
		"prepack": "tsc --sourceMap false",
		"test": "xo && tsc --noEmit",
		"watch": "tsc --watch"
	},
	"files": [
		"index.js",
		"index.d.ts"
	],
	"keywords": [
		"browser",
		"chrome",
		"safari",
		"extension",
		"web",
		"background",
		"window",
		"content script",
		"messaging",
		"communication",
		"webextension"
	],
	"devDependencies": {
		"@parcel/config-webextension": "^2.16.4",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/chrome": "^0.3.5",
		"globals": "^17.13.0",
		"parcel": "^2.16.4",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	},
	"@parcel/resolver-default": {
		"packageExports": true
	},
	"targets": {
		"main": false,
		"mv3": {
			"engines": {
				"browsers": "last 2 Chrome versions"
			},
			"source": "demo/manifest.json",
			"sourceMap": {
				"inline": true
			}
		}
	},
	"webExt": {
		"sourceDir": "dist",
		"run": {
			"startUrl": [
				"https://example.com"
			]
		}
	}
}
